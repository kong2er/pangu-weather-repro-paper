# ===== Paths (ALL heavy artifacts on data disk) =====
export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# DATA_ROOT: 可通过环境变量覆盖；AutoDL 自动检测 /root/autodl-tmp；其他环境用项目相对路径
if [[ -z "${DATA_ROOT:-}" ]]; then
    if [[ -d "/root/autodl-tmp" ]]; then
        export DATA_ROOT="/root/autodl-tmp/pangu-weather-repro"
    else
        export DATA_ROOT="${PROJECT_ROOT}/data_root"
    fi
fi
export ERA5_RAW_ROOT=$DATA_ROOT/era5_raw
export PROCESSED_ROOT=$DATA_ROOT/processed
export OUTPUT_ROOT=$DATA_ROOT/outputs
export MODELS_ROOT=$DATA_ROOT/models
export CACHE_ROOT=$DATA_ROOT/cache
export LOG_ROOT=$DATA_ROOT/logs

# ===== Default date/time =====
export DATE=20230709
export HOUR=00

# ===== Repro / threads =====
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# --- optional defaults for reproducibility ---
# If MODEL_PATH is not set, scripts will use MODELS_ROOT + step to locate model.
# You can still override via: export MODEL_PATH=...
# --- Day3 fixed: ORT CUDA libs are set by env_gpu.sh / run_gpu.sh ---

# ===== SSL CA 证书修复（AutoDL/容器环境常见问题）=====
# 容器镜像可能缺少 CA 根证书，导致 HTTPS 下载报 SSL_CERTIFICATE_VERIFY_FAILED。
# 优先使用 Python certifi 包的 CA bundle（比系统证书更新更全）。
if [[ -z "${SSL_CERT_FILE:-}" && -z "${REQUESTS_CA_BUNDLE:-}" ]]; then
  _CERTIFI_CA=""
  for _PY in "${PROJECT_ROOT}/.venv-gpu/bin/python" "${PROJECT_ROOT}/.venv-cpu/bin/python" "python3" "python"; do
    if command -v "${_PY}" >/dev/null 2>&1 || [[ -x "${_PY}" ]]; then
      _CERTIFI_CA="$("${_PY}" -c "import certifi; print(certifi.where())" 2>/dev/null || true)"
      if [[ -n "${_CERTIFI_CA}" && -f "${_CERTIFI_CA}" ]]; then
        break
      fi
      _CERTIFI_CA=""
    fi
  done
  if [[ -n "${_CERTIFI_CA}" ]]; then
    export SSL_CERT_FILE="${_CERTIFI_CA}"
    export REQUESTS_CA_BUNDLE="${_CERTIFI_CA}"
    export CURL_CA_BUNDLE="${_CERTIFI_CA}"
  fi
  unset _CERTIFI_CA _PY
fi

# ===== ORT CUDA stability defaults (Day3 proven) =====
export ORT_CUDA_ENABLE_ARENA=0
export ORT_CUDA_ALLOCATOR=cuda_malloc_async
export ORT_CUDNN_ALGO_SEARCH=DEFAULT
export ORT_INTRA_OP=1
export ORT_INTER_OP=1

