# ===== Paths (ALL heavy artifacts on AutoDL data disk) =====
export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DATA_ROOT=/root/autodl-tmp/pangu-weather-repro
export ERA5_RAW_ROOT=$DATA_ROOT/era5_raw
export PROCESSED_ROOT=$DATA_ROOT/processed
export OUTPUT_ROOT=$DATA_ROOT/outputs
export MODELS_ROOT=$DATA_ROOT/models
export CACHE_ROOT=$DATA_ROOT/cache
export LOG_ROOT=$DATA_ROOT/logs

# ===== Default date/time =====
export DATE=20230709
export HOUR=00

# ===== Repro / threads =====
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# --- optional defaults for reproducibility ---
# If MODEL_PATH is not set, scripts will use MODELS_ROOT + step to locate model.
# You can still override via: export MODEL_PATH=...
# --- Day3 fixed: make ORT CUDA libs always discoverable (pip nvidia cu12 wheels) ---
export _VENV_SITE="$(echo "$PROJECT_ROOT"/.venv/lib/python*/site-packages | awk '{print $1}')"
export LD_LIBRARY_PATH="$_VENV_SITE/nvidia/cublas/lib:$_VENV_SITE/nvidia/cudnn/lib:$_VENV_SITE/nvidia/cufft/lib:$_VENV_SITE/nvidia/curand/lib:$_VENV_SITE/nvidia/cusolver/lib:$_VENV_SITE/nvidia/cusparse/lib:$_VENV_SITE/nvidia/cuda_runtime/lib:$_VENV_SITE/nvidia/cuda_nvrtc/lib:$_VENV_SITE/nvidia/nvjitlink/lib:${LD_LIBRARY_PATH:-}"
